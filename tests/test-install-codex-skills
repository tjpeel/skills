#!/usr/bin/env bash
# Lightweight end-to-end checks for grouped, prefix-qualified skill installation.

set -euo pipefail

SCRIPT_DIRECTORY="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)"
REPOSITORY_DIRECTORY="$(CDPATH= cd -- "$SCRIPT_DIRECTORY/.." && pwd -P)"
INSTALLER="$REPOSITORY_DIRECTORY/scripts/install-codex-skills"
UNINSTALLER="$REPOSITORY_DIRECTORY/scripts/uninstall-codex-skills"
PREFIX="test"
TEST_DIRECTORY="$(mktemp -d "${TMPDIR:-/tmp}/codex-skills-test.XXXXXX")"
TARGET_DIRECTORY="$TEST_DIRECTORY/skills"

cleanup() {
  rm -rf -- "$TEST_DIRECTORY"
}
trap cleanup EXIT

skills=()
while IFS= read -r -d '' manifest; do
  skills+=("${manifest%/SKILL.md}")
done < <(find "$REPOSITORY_DIRECTORY" -mindepth 3 -type f -name SKILL.md -print0 | LC_ALL=C sort -z)

[[ ${#skills[@]} -gt 0 ]]

source_names=()
for skill_directory in "${skills[@]}"; do
  source_names+=("$(sed -n 's/^name: *//p' "$skill_directory/SKILL.md" | head -n 1)")
done

assert_internal_references_rewritten() {
  local source_file="$1" destination_file="$2" source_reference known_source_name local_reference

  if grep -qE '\$[a-z0-9][a-z0-9-]*' "$source_file"; then
    while IFS= read -r source_reference; do
      source_reference="${source_reference#\$}"
      [[ -n "$source_reference" ]]
      local_reference=false
      for known_source_name in "${source_names[@]}"; do
        [[ "$known_source_name" == "$source_reference" ]] && local_reference=true
      done
      [[ "$local_reference" == true ]] || continue
      grep -Fq "\$$PREFIX-$source_reference" "$destination_file"
      ! grep -Fq "\$$source_reference" "$destination_file"
    done < <(grep -oE '\$[a-z0-9][a-z0-9-]*' "$source_file" | LC_ALL=C sort -u)
  fi
}

"$INSTALLER" --prefix "$PREFIX" "$TARGET_DIRECTORY" >/dev/null
"$INSTALLER" --prefix "$PREFIX" --check "$TARGET_DIRECTORY" >/dev/null

for skill_directory in "${skills[@]}"; do
  relative_path="${skill_directory#"$REPOSITORY_DIRECTORY"/}"
  source_name="${relative_path//\//-}"
  installed_name="$PREFIX-$source_name"
  destination="$TARGET_DIRECTORY/$installed_name"

  [[ "$(sed -n 's/^name: *//p' "$skill_directory/SKILL.md" | head -n 1)" == "$source_name" ]]
  [[ -d "$destination" && ! -L "$destination" ]]
  [[ "$(sed -n 's/^name: *//p' "$destination/SKILL.md" | head -n 1)" == "$installed_name" ]]
  [[ -f "$skill_directory/agents/openai.yaml" ]]
  [[ -f "$destination/agents/openai.yaml" && ! -L "$destination/agents/openai.yaml" ]]
  [[ "$(sed -n 's/^[[:space:]]*display_name:[[:space:]]*"\([^"]*\)".*/\1/p' "$destination/agents/openai.yaml")" == "$installed_name" ]]
  grep -Fq "\$$source_name" "$skill_directory/agents/openai.yaml"
  grep -Fq "\$$installed_name" "$destination/agents/openai.yaml"

  assert_internal_references_rewritten "$skill_directory/SKILL.md" "$destination/SKILL.md"
  for metadata in "$skill_directory/agents"/*; do
    assert_internal_references_rewritten "$metadata" "$destination/agents/$(basename -- "$metadata")"
  done

  for resource in "$skill_directory"/*; do
    [[ "$(basename -- "$resource")" == "SKILL.md" || "$(basename -- "$resource")" == "agents" ]] && continue
    [[ -L "$destination/$(basename -- "$resource")" ]]
    [[ "$(readlink "$destination/$(basename -- "$resource")")" == "$resource" ]]
  done
done

foreign_target="$TARGET_DIRECTORY/$PREFIX-ee-foreign-skill"
mkdir -p "$foreign_target"
"$UNINSTALLER" --prefix "$PREFIX" --check "$TARGET_DIRECTORY" >/dev/null
"$UNINSTALLER" --prefix "$PREFIX" "$TARGET_DIRECTORY" >/dev/null

for skill_directory in "${skills[@]}"; do
  relative_path="${skill_directory#"$REPOSITORY_DIRECTORY"/}"
  installed_name="$PREFIX-${relative_path//\//-}"
  [[ ! -e "$TARGET_DIRECTORY/$installed_name" && ! -L "$TARGET_DIRECTORY/$installed_name" ]]
done
[[ -d "$foreign_target" ]]

"$INSTALLER" --prefix "$PREFIX" "$TARGET_DIRECTORY" >/dev/null

first_skill="${skills[0]}"
first_relative="${first_skill#"$REPOSITORY_DIRECTORY"/}"
conflict_name="$PREFIX-${first_relative//\//-}"
conflict_target="$TEST_DIRECTORY/conflict"
mkdir -p "$conflict_target/$conflict_name"
printf '%s\n' '---' 'name: preserved' 'description: Existing skill.' '---' 'Do not replace this skill.' > "$conflict_target/$conflict_name/SKILL.md"
if "$INSTALLER" --prefix "$PREFIX" "$conflict_target" >/dev/null 2>&1; then
  echo "Expected an existing skill directory to remain a conflict." >&2
  exit 1
fi
[[ "$(sed -n 's/^name: *//p' "$conflict_target/$conflict_name/SKILL.md" | head -n 1)" == "preserved" ]]

echo "Grouped skill install and uninstall checks passed."
