#!/usr/bin/env bash
# Install grouped skill packages in a Codex skill root.

set -euo pipefail

usage() {
  cat <<'EOF'
Usage: install-codex-skills --prefix PREFIX [--check | --install] [TARGET_DIRECTORY]

Modes:
  --check    Report this repository's installed, missing, and conflicting skills.
  --install  Add missing skills and leave every existing path untouched.

Each skill is stored at a nested path ending in SKILL.md. PREFIX is required
and must use lowercase letters, digits, and hyphens. Every directory in the
path becomes part of the installed skill name; for example, --prefix tjpeel
installs pr/review as tjpeel-pr-review.
TARGET_DIRECTORY defaults to ~/.codex/skills for the current user. A literal
~ or ~/ path is resolved against the current user's home directory.

EOF
}

MODE="--install"
PREFIX=""
TARGET_DIRECTORY="$HOME/.codex/skills"
target_given=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    --prefix)
      if [[ $# -lt 2 ]]; then
        echo "--prefix requires a value." >&2
        exit 2
      fi
      PREFIX="$2"
      shift 2
      ;;
    --check|--install)
      MODE="$1"
      shift
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    --)
      shift
      break
      ;;
    --*)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 2
      ;;
    *)
      if [[ "$target_given" == true ]]; then
        echo "Only one target directory may be supplied." >&2
        usage >&2
        exit 2
      fi
      TARGET_DIRECTORY="$1"
      target_given=true
      shift
      ;;
  esac
done

if [[ -z "$PREFIX" ]]; then
  echo "--prefix is required." >&2
  usage >&2
  exit 2
fi

if [[ ! "$PREFIX" =~ ^[a-z0-9][a-z0-9-]*$ ]]; then
  echo "PREFIX must start with a lowercase letter or number and use only lowercase letters, numbers, or hyphens." >&2
  exit 2
fi

case "$TARGET_DIRECTORY" in
  '~') TARGET_DIRECTORY="$HOME" ;;
  '~/'*) TARGET_DIRECTORY="$HOME/${TARGET_DIRECTORY:2}" ;;
esac

if [[ "$TARGET_DIRECTORY" != /* ]]; then
  echo "TARGET_DIRECTORY must be absolute or begin with ~/: $TARGET_DIRECTORY" >&2
  exit 2
fi

SCRIPT_DIRECTORY="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)"
REPOSITORY_DIRECTORY="$(CDPATH= cd -- "$SCRIPT_DIRECTORY/.." && pwd -P)"

if [[ ! -d "$TARGET_DIRECTORY" ]]; then
  if [[ "$MODE" == "--check" ]]; then
    echo "Target directory does not exist: $TARGET_DIRECTORY" >&2
    exit 1
  fi
  mkdir -p -- "$TARGET_DIRECTORY"
fi

skills=()
while IFS= read -r -d '' candidate; do
  skills+=("${candidate%/SKILL.md}")
done < <(find "$REPOSITORY_DIRECTORY" -mindepth 3 -type f -name SKILL.md -print0 | LC_ALL=C sort -z)

if [[ ${#skills[@]} -eq 0 ]]; then
  echo "No skills found. Add a nested path ending in SKILL.md under:" >&2
  echo "  $REPOSITORY_DIRECTORY" >&2
  exit 1
fi

link_name_for() {
  local skill_directory="$1"
  local relative_path
  relative_path="${skill_directory#"$REPOSITORY_DIRECTORY"/}"
  printf '%s-%s' "$PREFIX" "${relative_path//\//-}"
}

installed_name_for() {
  sed -n 's/^name: *//p' "$1/SKILL.md" | head -n 1
}

source_name_for() {
  sed -n 's/^name: *//p' "$1/SKILL.md" | head -n 1
}

source_names=()
link_names=()
for skill_directory in "${skills[@]}"; do
  source_name="$(source_name_for "$skill_directory")"
  link_name="$(link_name_for "$skill_directory")"

  if [[ -z "$source_name" ]]; then
    echo "Missing skill name: $skill_directory/SKILL.md" >&2
    exit 1
  fi

  if [[ -n "${source_names[0]+set}" ]]; then
    for known_source_name in "${source_names[@]}"; do
      if [[ "$known_source_name" == "$source_name" ]]; then
        echo "Duplicate skill name: $source_name" >&2
        exit 1
      fi
    done
  fi

  source_names+=("$source_name")
  link_names+=("$link_name")
done

rewrite_internal_skill_references() {
  local source_file="$1" index source_name link_name
  local sed_arguments=()

  for index in "${!source_names[@]}"; do
    source_name="${source_names[$index]}"
    link_name="${link_names[$index]}"
    sed_arguments+=(-e 's/[$]'"$source_name"'\([^[:alnum:]-]\)/$'"$link_name"'\1/g')
    sed_arguments+=(-e 's/[$]'"$source_name"'$/$'"$link_name"'/g')
  done

  sed "${sed_arguments[@]}" "$source_file"
}

install_agents_metadata() {
  local skill_directory="$1" link_name="$2" destination="$3" metadata

  [[ -d "$skill_directory/agents" ]] || return 0
  mkdir -- "$destination/agents"
  for metadata in "$skill_directory/agents"/*; do
    if [[ "$(basename -- "$metadata")" == "openai.yaml" ]]; then
      rewrite_internal_skill_references "$metadata" | sed \
        -e "s/^\\([[:space:]]*display_name:[[:space:]]*\\).*/\\1\"$link_name\"/" \
        > "$destination/agents/openai.yaml"
    else
      rewrite_internal_skill_references "$metadata" > "$destination/agents/$(basename -- "$metadata")"
    fi
  done
}

install_skill() {
  local skill_directory="$1" link_name="$2" destination="$3" entry

  mkdir -- "$destination"
  rewrite_internal_skill_references "$skill_directory/SKILL.md" | sed "s/^name: .*/name: $link_name/" > "$destination/SKILL.md"
  for entry in "$skill_directory"/*; do
    [[ "$(basename -- "$entry")" == "SKILL.md" ]] && continue
    if [[ "$(basename -- "$entry")" == "agents" ]]; then
      install_agents_metadata "$skill_directory" "$link_name" "$destination"
    else
      ln -s -- "$entry" "$destination/$(basename -- "$entry")"
    fi
  done
}

status=0
check() {
  local skill_directory link_name destination

  echo "Repository: $REPOSITORY_DIRECTORY"
  echo "Target:     $TARGET_DIRECTORY"
  echo "Prefix:     $PREFIX"

  for skill_directory in "${skills[@]}"; do
    link_name="$(link_name_for "$skill_directory")"
    destination="$TARGET_DIRECTORY/$link_name"

    if [[ -d "$destination" && ! -L "$destination" && -f "$destination/SKILL.md" && "$(installed_name_for "$destination")" == "$link_name" ]]; then
      echo "installed  $link_name"
    elif [[ -e "$destination" || -L "$destination" ]]; then
      echo "conflict   $link_name -> $(readlink "$destination" 2>/dev/null || echo 'not a symlink')"
      status=1
    else
      echo "missing    $link_name"
      status=1
    fi
  done

}

case "$MODE" in
  --check)
    check
    exit "$status"
    ;;
  --install)
    for skill_directory in "${skills[@]}"; do
      link_name="$(link_name_for "$skill_directory")"
      destination="$TARGET_DIRECTORY/$link_name"
      if [[ -d "$destination" && ! -L "$destination" && -f "$destination/SKILL.md" && "$(installed_name_for "$destination")" == "$link_name" ]]; then
        echo "installed  $link_name"
      elif [[ -e "$destination" || -L "$destination" ]]; then
        echo "Refusing to replace existing path: $destination" >&2
        status=1
      else
        install_skill "$skill_directory" "$link_name" "$destination"
        echo "installed  $link_name"
      fi
    done
    exit "$status"
    ;;
esac
