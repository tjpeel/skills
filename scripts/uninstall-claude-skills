#!/usr/bin/env bash
# Remove this repository's Claude Code skill packages from one explicit root.

set -euo pipefail

usage() {
  cat <<'EOF'
Usage: uninstall-claude-skills [--check | --uninstall] [TARGET_DIRECTORY]

Modes:
  --check      Report this repository's installed and missing skill packages.
  --uninstall  Remove this repository's installed skill packages.

TARGET_DIRECTORY defaults to ~/.claude/skills for the current user. A literal
~ or ~/ path is resolved against the current user's home directory.

EOF
}

MODE="--uninstall"
TARGET_DIRECTORY="$HOME/.claude/skills"
target_given=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    --check|--uninstall)
      MODE="$1"
      shift
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    --)
      shift
      break
      ;;
    --*)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 2
      ;;
    *)
      if [[ "$target_given" == true ]]; then
        echo "Only one target directory may be supplied." >&2
        usage >&2
        exit 2
      fi
      TARGET_DIRECTORY="$1"
      target_given=true
      shift
      ;;
  esac
done

case "$TARGET_DIRECTORY" in
  '~') TARGET_DIRECTORY="$HOME" ;;
  '~/'*) TARGET_DIRECTORY="$HOME/${TARGET_DIRECTORY:2}" ;;
esac

if [[ "$TARGET_DIRECTORY" != /* ]]; then
  echo "TARGET_DIRECTORY must be absolute or begin with ~/: $TARGET_DIRECTORY" >&2
  exit 2
fi

SCRIPT_DIRECTORY="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)"
REPOSITORY_DIRECTORY="$(CDPATH= cd -- "$SCRIPT_DIRECTORY/.." && pwd -P)"

skills=()
while IFS= read -r -d '' candidate; do
  skills+=("${candidate%/SKILL.md}")
done < <(find "$REPOSITORY_DIRECTORY" -mindepth 3 -type f -name SKILL.md -print0 | LC_ALL=C sort -z)

if [[ ${#skills[@]} -eq 0 ]]; then
  echo "No skills found under: $REPOSITORY_DIRECTORY" >&2
  exit 1
fi

source_name_for() {
  sed -n 's/^name: *//p' "$1/SKILL.md" | head -n 1
}

is_owned_skill() {
  local destination="$1" source_name="$2"

  [[ -d "$destination" && -f "$destination/SKILL.md" && -f "$destination/.personal-skills-source" ]] || return 1
  [[ "$(source_name_for "$destination")" == "$source_name" && "$(<"$destination/.personal-skills-source")" == "$source_name" ]]
}

status=0
for skill_directory in "${skills[@]}"; do
  source_name="$(source_name_for "$skill_directory")"
  if [[ -z "$source_name" ]]; then
    echo "Missing skill name: $skill_directory/SKILL.md" >&2
    exit 1
  fi
  destination="$TARGET_DIRECTORY/$source_name"

  if [[ -e "$destination" || -L "$destination" ]]; then
    if is_owned_skill "$destination" "$source_name" && [[ "$MODE" == "--check" ]]; then
      echo "installed  $source_name"
    elif is_owned_skill "$destination" "$source_name"; then
      rm -rf -- "$destination"
      echo "uninstalled  $source_name"
    else
      echo "Refusing to remove conflicting path: $destination" >&2
      exit 1
    fi
  else
    echo "missing    $source_name"
    [[ "$MODE" == "--check" ]] && status=1 || true
  fi
done

if [[ "$status" -ne 0 ]]; then
  exit "$status"
fi
